<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>ItemVault</AssemblyName>
    <RootNamespace>ItemVault</RootNamespace>
    <Version>1.0.1.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
   
    <DalamudLibraryReference Include="ImGui.NET" />
    <DalamudLibraryReference Include="Lumina" />
    <DalamudLibraryReference Include="Lumina.Excel" />
  </ItemGroup>
</Project>
